# Normaliza quebras de linha: LF no repositorio, nativo no disco de cada um.
# Sem isto, quem edita no Windows e quem edita no Mac/Linux geram diffs falsos
# em que o arquivo inteiro aparece como alterado.
* text=auto eol=lf

# Scripts do PowerShell precisam de CRLF no Windows.
*.ps1 text eol=crlf

# Binarios: nunca converter.
*.pdf  binary
*.png  binary
*.jpg  binary
*.jpeg binary
